      "landmark-inference",
      "nonuniform-anatomy-distortion",
      "procedural-anatomy",
      "asset-id-renaming"
    ]
  },
  "junctionContract": {
    "selection": "deterministic lookup by stable authored targetId",
    "mouthClip": "destination-in using selected authored base alpha",
    "mouthSeamTransform": "same as composition; full-canvas base alignment",
    "hornSeamTransform": "same as horn authored placement slot and pair override",
    "mayContain": [
      "overlap shadows",
      "cheek-colour cover shapes",
      "lip-edge cover shapes",
      "horn-root contour folds",
      "short highlight marks",
      "authored local distress"
    ],
    "mustNotContain": [
      "complete head silhouettes",
      "complete mouths",
      "teeth",
      "complete horns",
      "complete ears",
      "eyes",
      "noses",
      "runtime-generated geometry",
      "monster anatomy that reads independently"
    ]
  },
  "finishContract": {
    "stage": "after-approved-art-and-junction-composition",
    "transform": "same-as-composition",
    "mask": "destination-in using composed artwork alpha",
    "mayContain": ["hatching", "stipple", "blackwork shadow masses", "registration accents", "scratches", "distress"],
    "mustNotContain": ["head silhouettes", "eyes", "noses", "mouths", "teeth", "horns", "ears", "monster anatomy"]
