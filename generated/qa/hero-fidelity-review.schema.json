{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/hero-fidelity-review.schema.json",
  "title": "Human MVP fidelity review set",
  "type": "object",
  "required": ["schemaVersion", "reviewSetId", "status", "scoreScale", "targets", "reviews"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reviewSetId": {"type": "string", "minLength": 1},
    "status": {"enum": ["human-confirmation-required", "human-confirmed"]},
    "scoreScale": {"const": [1,2,3,4,5]},
    "targets": {"$ref": "#/$defs/scores"},
    "reviews": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/review"}}
  },
  "$defs": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouetteStrength","attachmentIntegration","expressionRead","detailDensity","thumbnailRead","mvpSimilarity"],
      "properties": {
        "silhouetteStrength":{"type":"integer","minimum":1,"maximum":5},
        "attachmentIntegration":{"type":"integer","minimum":1,"maximum":5},
        "expressionRead":{"type":"integer","minimum":1,"maximum":5},
        "detailDensity":{"type":"integer","minimum":1,"maximum":5},
        "thumbnailRead":{"type":"integer","minimum":1,"maximum":5},
        "mvpSimilarity":{"type":"integer","minimum":1,"maximum":5}
      }
    },
    "review": {
      "type": "object",
      "required": ["recipeId","reviewer","reviewedAt","assetIds","junctionIds","baseline","current","notes","humanConfirmed"],
      "properties": {
        "recipeId":{"type":"string"},
        "reviewer":{"type":"string","minLength":1},
        "reviewedAt":{"type":"string","format":"date-time"},
        "assetIds":{"type":"object","required":["base","eyes","nose","mouth","hornOrEar","pattern","extra","finish"],"additionalProperties":{"type":"string"}},
        "junctionIds":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},
        "baseline":{"$ref":"#/$defs/scores"},
        "current":{"$ref":"#/$defs/scores"},
        "notes":{"type":"array","minItems":1,"items":{"type":"object","required":["scope","stableId","text"],"properties":{"scope":{"enum":["recipe","base","mouth","hornOrEar","junction","finish","asset"]},"stableId":{"type":"string"},"text":{"type":"string","minLength":1}}}},
        "humanConfirmed":{"type":"boolean"}
      }
    }
  }
}
