{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v10-mouth-validation-report.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "revision",
    "issue",
    "valid",
    "errors",
    "counts",
    "digest",
    "reviewMatrix"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string"
    },
    "revision": {
      "const": "10.1.0"
    },
    "issue": {
      "const": 34
    },
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "baselineMouths",
        "newMouths",
        "totalMouths",
        "exactPairPlates",
        "reviewCells"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewMatrix": {
      "type": "array",
      "minItems": 720
    }
  }
}
