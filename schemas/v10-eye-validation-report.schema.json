{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v10-eye-validation-report.schema.json",
  "title": "V10 eye validation report",
  "type": "object",
  "required": [
    "schemaVersion",
    "issue",
    "revision",
    "status",
    "runtimeGeometry",
    "humanApprovalRequired",
    "baseline",
    "added",
    "target",
    "totalAfterPack",
    "approvedBasePairs",
    "rigidPlacementCount",
    "checks",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "issue": {
      "const": 41
    },
    "revision": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "runtimeGeometry": {
      "const": false
    },
    "humanApprovalRequired": {
      "const": true
    },
    "baseline": {
      "type": "integer",
      "minimum": 0
    },
    "added": {
      "type": "integer",
      "minimum": 20
    },
    "target": {
      "type": "integer",
      "minimum": 30
    },
    "totalAfterPack": {
      "type": "integer",
      "minimum": 30
    },
    "approvedBasePairs": {
      "type": "integer",
      "minimum": 1
    },
    "rigidPlacementCount": {
      "const": 20
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20
    }
  }
}
